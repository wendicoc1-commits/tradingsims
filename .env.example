# Midtrans Payment Gateway Configuration
# Dapatkan Server Key dan Client Key di: https://dashboard.midtrans.com -> Settings -> Access Keys

MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# URL Webhook Notification Midtrans yang dimasukkan ke Dashboard Midtrans:
# https://tradingsims.my.id/api/payment/webhook

# Supabase Database & Auth Configuration
# Dapatkan Project URL dan Anon Key di: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
