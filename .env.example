# ==============================================================================
# TradeSims Environment Variables Configuration Template
# Salin file ini menjadi .env.local dan isi dengan kredensial rahasia Anda.
# JANGAN PERNAH meng-commit file .env.local yang berisi kredensial asli ke Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration
# Dapatkan di: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here
# SUPABASE_SERVICE_ROLE_KEY hanya untuk backend server (JANGAN gunakan prefix NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# ------------------------------------------------------------------------------
# 2. Administrator Panel Security (/admin)
# ------------------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=your-super-strong-admin-password-min-12-chars
# Secret key 32+ karakter acak untuk HMAC token autentikasi sesi admin
ADMIN_SESSION_SECRET=your-random-32-chars-session-secret-key-here

# ------------------------------------------------------------------------------
# 3. Midtrans Payment Gateway Configuration
# Dapatkan di: https://dashboard.midtrans.com -> Settings -> Access Keys
# ------------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# URL Webhook Notification Midtrans yang dimasukkan ke Dashboard Midtrans:
# https://tradingsims.my.id/api/payment/webhook

# ------------------------------------------------------------------------------
# 4. Telegram Bot Alert Notifications
# Dapatkan di: BotFather (@BotFather) & Chat ID via @userinfobot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 5. AI Reasoning & Engine Integration
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
GROQ_API_KEYS=gsk_your-primary-groq-key,gsk_your-backup-groq-key
PYTHON_AGENT_URL=http://localhost:8000
QUANT_BRIDGE_URL=http://127.0.0.1:8002
QUANT_BRIDGE_SECRET=your-internal-quant-bridge-secret

# ------------------------------------------------------------------------------
# 6. Site URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tradingsims.my.id
